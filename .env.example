# Set this in Netlify Site configuration for the production canonical URL.
NEXT_PUBLIC_SITE_URL=https://your-production-domain.example

# Optional public profile links used by Person JSON-LD.
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/your-profile
NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/developer?id=your-developer-id
